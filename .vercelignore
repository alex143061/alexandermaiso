# Vercel ignore file
# This ensures Vercel builds correctly from source

# Ignore source files that will be built
src/
*.jsx
*.css
*.cjs

# Ignore non-essential files
.git
node_modules/
dist/

# Do NOT ignore these essential files
!package.json
!package-lock.json
!vercel.json
!vite.config.js
!tailwind.config.cjs
!postcss.config.cjs
!index.html
!public/
